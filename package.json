    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "lucide-react": "^0.344.0",
    "motion": "^12.39.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.7.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
